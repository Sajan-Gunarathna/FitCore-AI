# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-at-least-32-chars-long

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
# JWT secret — from Supabase Dashboard > Settings > API > JWT Secret
SUPABASE_JWT_SECRET=<your-jwt-secret>
# Issuer must match what Supabase puts in the 'iss' claim
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:3010","http://localhost:19006"]
